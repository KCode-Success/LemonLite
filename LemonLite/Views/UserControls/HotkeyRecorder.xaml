<UserControl x:Class="LemonLite.Views.UserControls.HotkeyRecorder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ws="https://schemas.elecho.dev/wpfsuite"
             d:DesignHeight="32"
             d:DesignWidth="200"
             Focusable="True"
             GotFocus="HotkeyRecorder_GotFocus"
             IsTabStop="True"
             LostFocus="HotkeyRecorder_LostFocus"
             mc:Ignorable="d">
    <Border x:Name="RootBorder"
            MinWidth="160"
            Height="32"
            Background="{DynamicResource MaskColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="10"
            Cursor="Hand"
            MouseDown="RootBorder_MouseDown">
        <Grid Margin="8,0">
            <TextBlock x:Name="DisplayText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource ForeColor}"
                       Text="" />
            <TextBlock x:Name="PlaceholderTextBlock"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource FocusMaskColor}"
                       Text=""
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
